<Base titulo="Marcas do Passado" descricao="Mostra virtual do CEMEF na 15ª Primavera dos Museus (2021): troféus esportivos do SAM e da FUNABEM.">
  <Cabecalho tag="Exposição 01 · 15ª Primavera dos Museus · 2021" lede="Mostra CEMEF Virtual sobre cultura material escolar: troféus de competições esportivas do SAM e da FUNABEM sob a guarda do Centro de Memória.">
    Marcas do <span class="ag-it">Passado</span>
  </Cabecalho>

  <section class="cm-bloco ag-wrap" aria-label="Vídeo de abertura">
    <Video id="g_9LcEmFiAQ" titulo="Abertura da Mostra Cultura Material Escolar" seed={21} />
  </section>

  <section class="cm-bloco ag-wrap" aria-label="A mostra em números">
    <div class="cm-figs" style="margin-top:0">
      <p class="cm-fig"><b>26</b><span>Troféus selecionados para a mostra.</span></p>
      <p class="cm-fig"><b>1950</b><span>Década das peças mais antigas da mostra.</span></p>
      <p class="cm-fig"><b>1980</b><span>Década das peças mais recentes.</span></p>
    </div>
